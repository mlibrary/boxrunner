#!/usr/bin/env sh

# Ensure user gem bin directory is available first for non-root environments.
GEM_USER_BIN="$(ruby -e 'print Gem.user_dir')/bin"
export PATH="${GEM_USER_BIN}:$PATH"

if ! command -v foreman >/dev/null 2>&1; then
  echo "Installing foreman in user gem directory..."
  gem install foreman --version 0.90.0 --no-document --user-install
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

exec foreman start -f Procfile.dev --env /dev/null "$@"
